# Azure AD App Registration (get these from portal.azure.com)
TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
CLIENT_SECRET=your-client-secret-value

# SharePoint file location
# SHAREPOINT_HOST: just the hostname, no https://
SHAREPOINT_HOST=lehi-ut.sharepoint.com

# SHAREPOINT_SITE_PATH: the path portion of your SharePoint site URL
# e.g. if your site is https://lehi-ut.sharepoint.com/sites/Power then use /sites/Power
SHAREPOINT_SITE_PATH=/sites/YourSiteName

# SHAREPOINT_FILE_PATH: path to the Excel file within the site's document library
# e.g. /Shared Documents/General/load-history.xlsx
SHAREPOINT_FILE_PATH=/Shared Documents/load-history.xlsx

# SHEET_NAME: name of the worksheet tab (default: Sheet1)
SHEET_NAME=Sheet1
